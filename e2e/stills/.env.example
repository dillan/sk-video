# OpenAI image generator — copy this to `.env` (same folder) and paste your key.
#   cp .env.example .env   then edit .env
# `.env` is gitignored (see repo-root .gitignore); never commit a real key.
# Get a key at https://platform.openai.com/api-keys — image gen bills a few cents per run.
OPENAI_API_KEY=

# Optional overrides (defaults are fine):
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1536x1024   # gpt-image-1's widest (3:2); the app covers/crops to fill
# OPENAI_IMAGE_QUALITY=high     # low | medium | high
